# Copy this file to lab/.env and fill in the values (see README.md).

# --- blockchain: Sepolia ---------------------------------------------------
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CONTRACT_ADDRESS=0x...            # printed by the Hardhat deploy (README step 3)
ATTESTOR_PRIVATE_KEY=0x...        # from: python make_attestor_key.py
FAUCET_PRIVATE_KEY=0x...          # your deployer wallet that holds Sepolia ETH (same as SEPOLIA_PRIVATE_KEY)
NETWORK_NAME=Sepolia
EXPLORER_URL=https://sepolia.etherscan.io

# --- top-ups ---------------------------------------------------------------
TOPUP_ETH=0.01
MAX_TOPUPS_PER_ACCOUNT=3

# --- access ---------------------------------------------------------------
ACCESS_CODE=kdu2026               # the panel needs this to create a wallet; change it

# --- Ethereum mainnet network data (Etherscan) -----------------------------
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
NETWORK_DELAY_SECONDS=3600        # show data one hour late
COLLECT_EVERY_SECONDS=60
